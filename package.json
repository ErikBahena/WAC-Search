{
  "name": "wac-search",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite-react-ssg build",
    "postbuild": "tsx scripts/generate-sitemap.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "scrape": "tsx scripts/scrape.ts",
    "build:data": "tsx scripts/build-data.ts",
    "build:intent-assets": "tsx scripts/build-intent-assets.ts",
    "generate:og": "tsx scripts/generate-og-image.ts",
    "qa:ground": "tsx scripts/ground-qa.ts",
    "qa:verify": "tsx scripts/verify-qa-grounding.ts",
    "ml:evaluate:runtime": "tsx scripts/evaluate-intent-runtime.ts",
    "ml:generate:in-scope": "python3 ml/generate_in_scope.py",
    "ml:generate:ood": "python3 ml/generate_ood.py",
    "ml:validate": "python3 ml/validate_dataset.py",
    "ml:train": "python3 ml/train_intent.py --model-name prajjwal1/bert-mini --data-dir ml/data --out-dir ml/artifacts/intent-v1",
    "ml:calibrate": "python3 ml/calibrate.py --model-dir ml/artifacts/intent-v1/model --val-file ml/data/val.jsonl --out-file ml/artifacts/intent-v1/calibration.json",
    "ml:evaluate": "python3 ml/evaluate.py --model-dir ml/artifacts/intent-v1/model --calibration ml/artifacts/intent-v1/calibration.json --test-file ml/data/test.jsonl --challenge-file ml/data/challenge.jsonl --out-file ml/artifacts/intent-v1/evaluation.json",
    "ml:export:onnx": "python3 ml/export_onnx.py --model-dir ml/artifacts/intent-v1/model --out-dir ml/artifacts/intent-v1/onnx",
    "ml:quantize": "python3 ml/quantize_onnx.py --onnx-dir ml/artifacts/intent-v1/onnx --label-map ml/artifacts/intent-v1/label_map.json --calibration ml/artifacts/intent-v1/calibration.json --public-model-dir public/models/intent-v1 --max-size-mb 25",
    "ml:full": "npm run ml:generate:in-scope && npm run ml:generate:ood && npm run ml:validate && npm run ml:train && npm run ml:calibrate && npm run ml:evaluate && npm run ml:export:onnx && npm run ml:quantize"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "@vercel/analytics": "^1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.3",
    "tailwind-merge": "^3.4.0",
    "vite-react-ssg": "^0.8.9"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.9",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "cheerio": "^1.2.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "node-fetch": "^2.7.0",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
